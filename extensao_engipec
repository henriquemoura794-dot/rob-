def aplicar_css_responsivo(html):
    """Insere viewport + CSS responsivo não-invasivo no HTML."""
    if 'viewport' not in html.lower():
        viewport = ('<meta name="viewport" content="width=device-width, '
                    'initial-scale=1.0, viewport-fit=cover">')
        match = re.search(r'<head[^>]*>', html, re.IGNORECASE)
        if match:
            html = html[:match.end()] + '\n  ' + viewport + html[match.end():]
        else:
            html = viewport + '\n' + html

    estilo = '<style>\n' + CSS_RESPONSIVO + '\n</style>'
    if re.search(r'</head>', html, re.IGNORECASE):
        html = re.sub(r'</head>', estilo + '\n</head>', html, count=1, flags=re.IGNORECASE)
    else:
        html = html + '\n' + estilo

    return html

def injetar_js_filtros(html):
    """Injeta o JS de correção antes de </body> (depois do script original)."""
    script = '<script>\n' + JS_CORRECAO_FILTROS + '\n</script>'
    if re.search(r'</body>', html, re.IGNORECASE):
        html = re.sub(r'</body>', script + '\n</body>', html, count=1, flags=re.IGNORECASE)
    else:
        html = html + '\n' + script
    return html

